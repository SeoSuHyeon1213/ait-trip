# 서버 전용 설정. 국문 서비스 기본 URL과 일반 인증키(Decoding)를 입력하세요.
TOUR_API_ENDPOINT=
TOUR_API_SERVICE_KEY=
TOUR_API_MOBILE_APP=ait-trip
PORT=3001

# 앱 번들에 들어가는 공개 API 서버 기본 주소(예: https://배포주소.onrender.com)
VITE_API_BASE_URL=
# 외부 서버 배포 시 설정
HOST=127.0.0.1
CORS_ALLOWED_ORIGINS=https://aitmidtotrip.apps.tossmini.com,https://aitmidtotrip.private-apps.tossmini.com
