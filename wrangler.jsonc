{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aitmidtotrip",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-11-13",
  "workers_dev": true,
  "assets": {
    "directory": "./dist-web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api",
      "/api/*",
      "/healthz"
    ]
  },
  "vars": {
    "TOUR_API_MOBILE_APP": "aitmidtotrip",
    "CORS_ALLOWED_ORIGINS": "https://aitmidtotrip.apps.tossmini.com,https://aitmidtotrip.private-apps.tossmini.com"
  },
  "keep_vars": true
}
